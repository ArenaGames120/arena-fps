; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Arena FPS"
config/description="Шутер от первого лица: меню, боты, карты de_dust2 и de_mirage, три ствола, режимы и уровни."
run/main_scene="res://scenes/Main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="bot_body"
3d_physics/layer_4="bot_head"

[rendering]

anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.45, 0.58, 0.72, 1)
